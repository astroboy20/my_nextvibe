{
  "expo": {
    "name": "nextvibe",
    "slug": "nextvibe",
    "version": "1.0.0",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mynextvibe",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nextvibe2026.nextvibe",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC73yaRGGiQ-W1qpni-3WlKJJ3A1vWtmUs"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      },
      "config": {
        "googleMapsApiKey": "AIzaSyC73yaRGGiQ-W1qpni-3WlKJJ3A1vWtmUs"
      }
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "android": { "enableNewArch": false },
          "ios": { "useFrameworks": "static" }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logos/new/logo_black_text.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NextVibe to access your camera to create postcards",
          "microphonePermission": "Allow NextVibe to access your microphone to record postcard videos",
          "recordAudioAndroid": true
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e837865d-1e7b-495f-b8dd-db9783e2435b"
      }
    },
    "owner": "nextvibe2026s-organization",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e837865d-1e7b-495f-b8dd-db9783e2435b",
      "enabled": true
    }
  }
}
