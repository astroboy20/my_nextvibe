EXPO_PUBLIC_GOOGLE_PLACES_KEY=AIzaSyC73yaRGGiQ-W1qpni-3WlKJJ3A1vWtmUs

# Google Sign-In — replace with your Google Cloud Console OAuth client IDs.
# Web client ID is required on both platforms (makes Google mint a verifiable ID token).
# iOS client ID is required on iOS so the native sign-in sheet appears correctly.
# Android client ID is registered server-side; no env var needed on the client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com

# remove.bg — background removal API key
EXPO_PUBLIC_REMOVE_BG_API_KEY=n1qaLTF7eoRBVzXHqaU5Kri9

# Set to 'true' when running with Expo Go to swap Firebase for a no-op mock.
# Leave unset or 'false' for development builds and production.
# Usage: EXPO_PUBLIC_USE_FIREBASE_MOCK=true expo start
EXPO_PUBLIC_USE_FIREBASE_MOCK=false
